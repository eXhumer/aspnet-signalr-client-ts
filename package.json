{
  "name": "@exhumer/aspnet-signalr-client",
  "version": "4.0.0-alpha1",
  "description": "ASP.NET SignalR client for Node.js.",
  "type": "module",
  "author": {
    "name": "eXhumer",
    "email": "github@exhumer.cc"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXhumer/aspnet-signalr-client-ts.git"
  },
  "bugs": {
    "url": "https://github.com/eXhumer/aspnet-signalr-client-ts/issues"
  },
  "homepage": "https://github.com/eXhumer/aspnet-signalr-client-ts#readme",
  "keywords": [
    "signalr",
    "websockets"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --reporter=junit --outputFile=test-report.junit.xml"
  },
  "dependencies": {
    "@exhumer/undici-cookie-agent": "^2.0.1",
    "tough-cookie": "^6.0.2",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
